# Lets the first person (the Head of GTM) sign in. Any length, at least 8 characters.
# Once signed in, issue access codes for people and Grokbots from Squads.
BOLDR_ADMIN_CODE=
# Signs session cookies. Use 32+ random characters, or leave it empty and Boldr generates one.
BOLDR_SECRET=
# Where the JSON data store lives. Defaults to ./data
DATA_DIR=./data
