# Lets the first person (the Head of GTM) sign in. Use a long random value (12+ characters).
# Once signed in, issue access codes for people and Grokbots from Squads.
BOLDR_ADMIN_CODE=
# Signs session cookies. Set a long random value in production.
BOLDR_SECRET=
# Where the JSON data store lives. Defaults to ./data
DATA_DIR=./data
